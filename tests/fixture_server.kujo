# Loopback-only HTTP/1.1 fixture. Routes and request state are owned by one task.
# The barrier holds three sockets before responding, proving real overlapping I/O.
export func fixture_reply(conn, status, body, headers) {
    let raw := body
    let head := "HTTP/1.1 " + to_string(status) + " Fixture\r\nConnection: close\r\nContent-Length: " + to_string(byte_length(raw)) + "\r\n" + headers + "\r\n"
    try {tcp_send(conn, head); tcp_send(conn, raw)} except err {
        # Timeout fixtures intentionally close the client before the response.
        if contains(to_string(err), "send") == 0 {error(to_string(err))}
    }
    tcp_close(conn)
}
export func fixture_request(port, command, config) {
    let conn := tcp_connect("127.0.0.1", port)
    tcp_send(conn, "GET /__fixture/" + command + " HTTP/1.1\r\nHost: localhost\r\nX-Fixture-Config: " + to_json(config) + "\r\n\r\n")
    mut response := ""
    loop {
        let chunk := tcp_receive(conn, 65536)
        if len(chunk) == 0 {break}
        response = response + chunk
        if len(response) > 4194304 {error("fixture control response exceeded bound")}
    }
    tcp_close(conn)
    return parse_json(split(response, "\r\n\r\n")[1])
}
func fixture_loop(listener, base, initial) {
    let routes := parse_json(replace(read_file("tests/fixtures/routes.json"), "{{BASE}}", base))
    mut cfg := initial
    mut paths := []
    mut methods := []
    mut times := []
    mut flaky := 0
    mut pending := []
    let pages := get_default(initial, "pages", 0)
    mut root_html := "<title>Page 0</title><meta name=\"description\" content=\"Page 0\">"
    mut sitemap := "<urlset>"
    for i in range(0, pages) {
        sitemap = sitemap + "<url><loc>" + base + "p/" + to_string(i) + "</loc></url>"
        if i > 0 {root_html = root_html + "<a href=\"/p/" + to_string(i) + "\">page " + to_string(i) + "</a>"}
    }
    sitemap = sitemap + "</urlset>"
    loop {
        let conn := tcp_accept(listener)
        mut request := ""
        loop {
            let chunk := tcp_receive(conn, 4096)
            if len(chunk) == 0 {tcp_close(conn); error("fixture client closed before complete headers")}
            request = request + chunk
            if contains(request, "\r\n\r\n") {break}
            if len(request) > 32768 {error("fixture request exceeded header bound")}
        }
        let lines := split(request, "\r\n")
        let parts := split(lines[0], " ")
        let path := parts[1]
        if starts_with(path, "/__fixture/") {
            if path == "/__fixture/reset" {
                for line in lines {if starts_with(line, "X-Fixture-Config: ") {cfg = parse_json(substring(line, 18, len(line)))}}
                paths = []; methods = []; times = []; flaky = 0
            }
            fixture_reply(conn, 200, to_json({"paths": paths, "methods": methods, "times": times}), "Content-Type: application/json\r\n")
            if path == "/__fixture/stop" {break}
            continue
        }
        paths = push(paths, path); methods = push(methods, parts[0]); times = push(times, performance_now())
        mut status := 404
        mut body := "<title>Not found</title>"
        mut headers := "Content-Type: text/html\r\n"
        if has_key(routes, path) {status = routes[path][0]; headers = "Content-Type: " + routes[path][1] + "\r\n"; body = routes[path][2]}
        if pages > 0 {
            status = 200
            if path == "/robots.txt" {body = "User-agent: *\nSitemap: " + base + "sitemap.xml\n"; headers = "Content-Type: text/plain\r\n"}
            else if path == "/sitemap.xml" {body = sitemap; headers = "Content-Type: application/xml\r\n"}
            else if path == "/p/0" {body = root_html}
            else {let index := split(path, "/")[2]; body = "<title>Page " + index + "</title><meta name=\"description\" content=\"Page " + index + "\"><a href=\"/p/0\">home</a>"}
        } else {
            if path == "/robots.txt" {
                status = get_default(cfg, "robots_status", 200)
                if get_default(cfg, "crawl_delay", 0) > 0 {body = replace(body, "User-agent: *\n", "User-agent: *\nCrawl-delay: " + to_string(cfg["crawl_delay"]) + "\n")}
            }
            if path == "/sitemap.xml.gz" {status = 200; body = gzip_compress(decode_base64(encode_base64(routes["/sitemap.xml"][2]))); headers = "Content-Type: application/gzip\r\n"}
            if path == "/" {headers = headers + "Link: </api>; rel=\"alternate\"; type=\"application/json\"\r\nLink: </feed>; rel=\"alternate\"; type=\"application/rss+xml\"\r\n"}
            if path == "/blocked-links" {status = 200; body = "<title>Blocked</title><a href=\"/private/a\">a</a><a href=\"/private/b\">b</a><a href=\"/private/c\">c</a>"}
            for pair in [["/redirect", "/duplicate"], ["/private-redirect", "/private"], ["/cross-origin-redirect", "https://example.net/escaped"]] {
                if path == pair[0] {status = 302; body = ""; headers = "Location: " + pair[1] + "\r\n"}
            }
            if path == "/flaky" {flaky = flaky + 1; status = 200; body = "<title>Recovered</title>"; if flaky < 2 {status = 429; body = ""; headers = "Retry-After: 0\r\n"}}
            if path == "/slow" {sleep(200); status = 200; body = "<title>Slow</title>"}
            if starts_with(path, "/etag") {
                headers = headers + "ETag: \"fixture-v1\"\r\n"
                if contains(request, "If-None-Match: \"fixture-v1\"")||contains(request, "if-none-match: \"fixture-v1\"") {status = 304; body = ""}
            }
            if get_default(cfg, "wide_sitemap", false) {
                if path == "/sitemap-index.xml" {
                    body = "<sitemapindex><sitemap><loc>https://example.invalid/foreign.xml</loc></sitemap>"
                    for i in range(0, 100) {for unused in range(0, 2) {body = body + "<sitemap><loc>" + base + "map-" + to_string(i) + ".xml</loc></sitemap>"}}
                    body = body + "</sitemapindex>"
                } else if starts_with(path, "/map-") {status = 200; body = "<urlset/>"}
            }
            if path == "/parallel-root" {status = 200; body = "<title>Parallel</title>"; for i in range(0, 3) {body = body + "<a href=\"/parallel/" + to_string(i) + "\">page</a>"}}
            if starts_with(path, "/parallel/") {
                pending = push(pending, conn)
                if len(pending) == 3 {for client in pending {fixture_reply(client, 200, "<title>Concurrent</title>", "Content-Type: text/html\r\n")}; pending = []}
                continue
            }
        }
        fixture_reply(conn, status, body, headers)
    }
    for client in pending {tcp_close(client)}
    return true
}
export func fixture_start(cfg) {
    env_set("KUJO_ALLOW_PRIVATE_NETWORK_DESTINATIONS", "1")
    mut last := ""
    for attempt in range(0, 16) {
        let port := random_int(20000, 60000)
        mut listener := null
        try {listener = tcp_listen("127.0.0.1", port)} except err {last = to_string(err); continue}
        let base := "http://127.0.0.1:" + to_string(port) + "/"
        async func serve() {return fixture_loop(listener, base, cfg)}
        let task := serve()
        return {"port": port, "base": base, "task": task}
    }
    error("Unable to bind private fixture listener after 16 attempts: " + last)
}
export func fixture_stop(server) {fixture_request(server["port"], "stop", {}); promise_wait(server["task"])}
