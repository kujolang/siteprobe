# SiteProbe's Kujo entrypoint. The Python bridge is deliberately bounded to
# standards-library HTTP, HTML, XML, and URL primitives that Kujo does not yet
# expose as a complete parsing stack.

func main() {
	command := ["python3", "bridge/siteprobe.py"]
	argv := args()
	i := 0
	loop {
		if i >= len(argv) { break }
		command = push(command, to_string(argv[i]))
		i := i + 1
	}
	result := spawn_process(command, {"timeout_ms": 900000})
	if result.stdout != "" { print(trim_end(result.stdout)) }
	if result.stderr != "" { print(trim_end(result.stderr)) }
	exit(result.exitcode)
}

main()
