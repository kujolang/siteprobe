from src.siteprobe import validate_run, read_json
# Emit SiteProbe links in a compact ContentGraph-ready envelope.
argv := args()
if len(argv) != 1 {print("usage: kujo run examples/contentgraph.kujo -- <run>"); exit(2)}
try {
    run_path := to_string(argv[0])
    let errors := validate_run(run_path)
    if len(errors) > 0 {error(join(errors, "; "))}
    links := read_json(run_path + "/links.json")
    print(to_json({"schema": "siteprobe.contentgraph-example/v1", "edges": links["links"]}))
} except err {print("contentgraph example error: " + to_string(err)); exit(1)}
