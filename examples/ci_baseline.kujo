# Compare validates both immutable runs before emitting any changes.
argv := args()
if len(argv) < 2||len(argv) > 3 {print("usage: kujo run examples/ci_baseline.kujo -- <baseline> <candidate> [kujo-runtime]"); exit(2)}
baseline := to_string(argv[0])
candidate := to_string(argv[1])
kujo := "kujo"
if len(argv) == 3 {kujo = to_string(argv[2])}
comparison := spawn_process([kujo, "run", "src/main.kujo", "--", "compare", baseline, candidate], {"timeout_ms": 120000, "max_output_bytes": 16777216, "env_deny": ["KUJO_SCRIPT_ARGS"]})
if comparison.timed_out||comparison.cancelled||comparison.stdout_truncated||comparison.stderr_truncated {
    eprint("SiteProbe comparison did not complete with full output; run siteprobe compare directly to stream large evidence.")
    exit(1)
}
if comparison.stdout != "" {print(trim_end(comparison.stdout))}
if comparison.stderr != "" {print(trim_end(comparison.stderr))}
exit(comparison.exitcode)
