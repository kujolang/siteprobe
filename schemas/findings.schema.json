{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kujolang.ai/siteprobe/findings.v1.json",
  "type": "object",
  "required": ["schema", "findings"],
  "properties": {
    "schema": {"const": "siteprobe.findings/v1"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "check", "target", "severity", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^SP-[A-F0-9]{16}$"},
          "check": {"type": "string", "minLength": 1},
          "target": {"type": "string", "format": "uri"},
          "severity": {"enum": ["info", "warning", "error"]},
          "evidence": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
