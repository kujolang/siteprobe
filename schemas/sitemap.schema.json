{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kujolang.ai/siteprobe/sitemap.v1.json",
  "title": "SiteProbe sitemap",
  "type": "object",
  "required": [
    "schema",
    "sitemaps",
    "urls",
    "errors"
  ],
  "properties": {
    "schema": {
      "const": "siteprobe.sitemap/v1"
    },
    "sitemaps": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "error"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
