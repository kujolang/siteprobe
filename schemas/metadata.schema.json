{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kujolang.ai/siteprobe/metadata.v1.json",
  "title": "SiteProbe metadata",
  "type": "object",
  "required": [
    "schema",
    "titles",
    "descriptions"
  ],
  "properties": {
    "schema": {
      "const": "siteprobe.metadata/v1"
    },
    "titles": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "descriptions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  },
  "additionalProperties": true
}
