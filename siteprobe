#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KUJO_RUNTIME="${KUJO_BIN:-$ROOT/../kujo/target/release/kujo}"
if [[ ! -x "$KUJO_RUNTIME" ]]; then
  printf 'SiteProbe: Kujo runtime not found. Set KUJO_BIN.\n' >&2
  exit 2
fi
cd "$ROOT"
exec "$KUJO_RUNTIME" run src/main.kujo -- "$@"
